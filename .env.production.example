# Copy to .env on the production VM and fill in real values. Never commit .env.
# Generate strong secrets:
#   JWT_SECRET=$(openssl rand -hex 48)
#   POSTGRES_PASSWORD=$(openssl rand -base64 32)

# --- App ---
APP_DOMAIN=erp.example.com           # leave empty to listen on :80 (no TLS) for IP-only testing
ACME_EMAIL=ops@example.com           # used by Caddy for Let's Encrypt

# --- DB ---
POSTGRES_USER=erp
POSTGRES_PASSWORD=change-me-strong-random
POSTGRES_DB=consignment_erp

# --- API ---
JWT_SECRET=change-me-very-long-random-hex
JWT_EXPIRES_IN=12h
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_COST=12
LOG_LEVEL=info

# --- First boot only ---
# Set RUN_SEED=true ONCE on a fresh DB to create admin user + permissions,
# then flip back to false so subsequent restarts don't re-seed.
RUN_SEED=false

# --- Backup → Oracle Object Storage (used by scripts/backup.sh) ---
OCI_BACKUP_BUCKET=consignment-backups
BACKUP_RETENTION_DAYS=14
